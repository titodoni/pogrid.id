APP_NAME=POgrid
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.pogrid.id

# ── DATABASE UTAMA: Neon.tech PostgreSQL ──────────────────────────
DB_CONNECTION=pgsql
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_DATABASE="pogrid' options='endpoint=your-endpoint"
DB_USERNAME=neondb_owner
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=require

# ── DATABASE LOKAL (SQLite): Session, Cache, & Queue ───────────────
SESSION_DRIVER=database
SESSION_CONNECTION=sqlite

CACHE_STORE=database
DB_CACHE_CONNECTION=sqlite
DB_CACHE_LOCK_CONNECTION=sqlite

QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=sqlite

# ── REALTIME BROADCASTING: Pusher ──────────────────────────────────
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=CHANGE_ME
PUSHER_APP_KEY=CHANGE_ME
PUSHER_APP_SECRET=CHANGE_ME
PUSHER_APP_CLUSTER=ap1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── EMAIL NOTIFIKASI: Hostinger SMTP ───────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=admin@pogrid.id
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=ssl
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="admin@pogrid.id"
MAIL_FROM_NAME="${APP_NAME}"
